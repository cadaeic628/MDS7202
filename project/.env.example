# Copiar a .env y completar los valores. NO versionar el .env real (está en .gitignore).

# Clave de Google AI Studio para el servicio de embeddings gemini-embedding-001 (la usa el backend).
GOOGLE_API_KEY=tu_api_key_aqui

# URL del backend que consume el frontend.
# En local: http://localhost:8000. En docker-compose se sobreescribe a http://backend:8000.
BACKEND_URL=http://localhost:8000
